# Copy to .env for local development. On Render, render.yaml wires up Redis
# and asks for everything else (including DATABASE_URL) during setup.

NODE_ENV=development
PORT=4000

# ── Database (Supabase) ──────────────────────────────────────────────
# Supabase → your project → Connect → "Session pooler" (port 5432). Replace
# [YOUR-PASSWORD] with the database password; if it contains characters
# like @ # / : ? % URL-encode them (e.g. @ → %40). Paste as-is otherwise: an
# ?sslmode=... suffix is fine, SSL is handled for you.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Avoid: "Direct connection" (db.<ref>.supabase.co) is IPv6-only, and the
# "Transaction pooler" (port 6543) is meant for serverless functions.
#
# Local Postgres instead (docker compose up -d postgres):
# DATABASE_URL=postgresql://travel:travelpass@localhost:5422/travel_guides
# ...or the parts (used only when DATABASE_URL is empty)
# DB_HOST=localhost
# DB_PORT=5422
# DB_USERNAME=travel
# DB_PASSWORD=travelpass
# DB_NAME=travel_guides

# SSL: on automatically for Supabase, off otherwise. DB_SSL=true/false
# overrides. To also verify the certificate, download it from Supabase
# (Database settings → SSL configuration) and point DB_SSL_CA at the file,
# or paste the PEM with \n for line breaks.
# DB_SSL=true
# DB_SSL_CA=./prod-ca-2021.crt

# Connections per process (API and worker each have a pool). Defaults to 5
# for Supabase, whose pooler caps clients (15 on the smallest plan), else 10.
# DB_POOL_MAX=5

# Row level security on every app table, so Supabase's public REST API can't
# read them. On automatically for Supabase; DB_ENABLE_RLS=true/false overrides.
# DB_ENABLE_RLS=true

# Create/update tables on startup. Always on when NODE_ENV=development;
# in production set true only for the first deploy to an empty database.
# DB_SYNCHRONIZE=false

# ── Redis (BullMQ queues + image cache) ──────────────────────────────
# Either a URL (Render Key Value, Upstash; rediss:// enables TLS)...
# REDIS_URL=redis://localhost:6379
# ...or host/port
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── Auth ─────────────────────────────────────────────────────────────
# Required in production (the API refuses to start without it)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed frontends; leading wildcards allowed for previews.
# Empty = allow any origin.
# CORS_ORIGINS=https://your-app.vercel.app,https://*.vercel.app

# ── AI providers ─────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional extra keys, comma-separated (rotated on rate limits)
# GEMINI_API_KEYS=key2,key3
# OPENAI_API_KEY=

# ── Cloudinary (image + document storage) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_TIMEOUT_MS=120000
